{
  "schema": 1,
  "language": "rust",
  "setup": [
    [
      "cargo",
      "fetch",
      "--locked",
      "--manifest-path",
      "fuzz/Cargo.toml"
    ],
    [
      "cargo",
      "+nightly-2026-10-12",
      "fuzz",
      "build",
      "--fuzz-dir",
      "fuzz",
      "--target",
      "x86_64-unknown-linux-gnu"
    ]
  ],
  "targets": [
    {
      "name": "energy-sources",
      "engine": "libfuzzer",
      "command": [
        "fuzz/target/x86_64-unknown-linux-gnu/release/energy_sources"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/energy_sources"
    },
    {
      "name": "command-payload",
      "engine": "libfuzzer",
      "command": [
        "fuzz/target/x86_64-unknown-linux-gnu/release/command_payload"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/command_payload"
    },
    {
      "name": "certificate-policy",
      "engine": "libfuzzer",
      "command": [
        "fuzz/target/x86_64-unknown-linux-gnu/release/certificate_policy"
      ],
      "seconds": 60,
      "corpus": "fuzz/corpus/certificate_policy"
    }
  ]
}
