{
  "version_file": "Cargo.toml",
  "validation_workflows": [
    "ci.yml",
    "codeql.yml"
  ],
  "artifact_pattern": "release-assets*",
  "local_checks": [
    "cargo fmt --all -- --check",
    "cargo clippy --locked --all-targets -- -D warnings",
    "cargo test --locked --all-targets"
  ],
  "notes": [
    "Container is exported as an OCI archive; registry/deployment promotion must consume it without rebuilding.",
    "Existing Linux amd64 target is retained; live MQTT/hardware validation remains separate."
  ],
  "container_assets": {
    "inverter-gateway-container.oci.tar": "ghcr.io/victron-venus/inverter-gateway"
  },
  "repository": "victron-venus/inverter-gateway",
  "mode": "release",
  "default_branch": "main",
  "visibility": "public",
  "versioning": {
    "schema": 1,
    "promotion": "promote-bytes",
    "files": [
      {
        "path": "Cargo.toml",
        "format": "toml",
        "value": "package",
        "field": "package.version"
      },
      {
        "path": "Cargo.lock",
        "format": "cargo-lock",
        "value": "package",
        "package": "inverter-gateway"
      }
    ],
    "artifacts": [
      {
        "path": "inverter-gateway-*.tar.gz",
        "format": "tar-json",
        "value": "package",
        "member": "build-info.json",
        "field": "version"
      },
      {
        "path": "inverter-gateway-container.oci.tar",
        "format": "oci",
        "field": [
          "config",
          "Labels",
          "org.opencontainers.image.version"
        ],
        "value": "package"
      }
    ],
    "toolkit_revision": "5671b9a05817576a8ae6bd69cacfb3202c60ad0a"
  }
}
