# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env

# Victron MQTT broker (Cerbo GX) — LAN hostname or IP
MQTT_HOST=cerbo.lan
MQTT_PORT=1883
MQTT_USERNAME=your_mqtt_user
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=inverter-gateway

# Prefer portal id (builds N/<id>/ and W/<id>/ prefixes).
# Fake placeholder for the example file — replace in .env.
VICTRON_PORTAL_ID=your_portal_id_here
# Or set an explicit prefix instead:
# VICTRON_TOPIC_PREFIX=N/your_portal_id_here/

# Bare-metal / SSH tunnel on the host: keep loopback.
# Docker overrides this to 0.0.0.0:8080 via docker-compose.
HTTP_BIND=127.0.0.1:8080

# Required API bearer (openssl rand -hex 32). App refuses to start without it
# unless GATEWAY_ALLOW_INSECURE=1 (local LAN escape hatch only).
GATEWAY_API_TOKEN=replace_with_openssl_rand_hex_32

# GATEWAY_ALLOW_INSECURE=0
# GATEWAY_CORS_ORIGINS=

RUST_LOG=info,inverter_gateway=info

# Optional override when using ./deploy-from-release (default: latest GitHub release)
# IMAGE_TAG=0.2.1
# GHCR is public — GHCR_TOKEN not required to pull.
