# Victron MQTT broker (Cerbo GX)
MQTT_HOST=cerbo.lan
MQTT_PORT=1883
MQTT_USERNAME=your_mqtt_user
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=inverter-gateway

# Victron topic prefix (default for Cerbo's local broker)
VICTRON_TOPIC_PREFIX=N/%instance%/

# HTTP bind
HTTP_BIND=0.0.0.0:8080

# Optional: bearer token for the API.
# Cloudflare Access at the edge is the primary auth barrier.
# Set this only if you also want an additional check at the app layer.
# GATEWAY_API_TOKEN=

# Logging
RUST_LOG=info,inverter_gateway=debug
