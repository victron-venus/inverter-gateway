# Victron MQTT broker (Cerbo GX)
MQTT_HOST=cerbo.lan
MQTT_PORT=1883
MQTT_USERNAME=your_mqtt_user
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=inverter-gateway

# Victron topic prefix. By default, this is a placeholder — replace with
# your real portal id (Cerbo/VRM) so the gateway subscribes to the right topics.
# Find the portal id in VRM → "System instance" or via `dbus-spy` on Cerbo.
# Examples:
#   VICTRON_PORTAL_ID=abc123  → builds "N/abc123/" automatically
#   VICTRON_TOPIC_PREFIX=N/abc123/  → explicit, overrides the portal-id shortcut
VICTRON_TOPIC_PREFIX=N/<portal_id>/

# HTTP bind — must stay on loopback for bare-metal / tunnel setups.
# Docker: inside the container the process listens on 0.0.0.0:8080 so
# Docker port-publishing works. Set HTTP_BIND=0.0.0.0:8080 in the compose
# service environment (override), while the host-side port mapping stays
# loopback-only: "127.0.0.1:8080:8080". Never expose 0.0.0.0 on the host.
HTTP_BIND=127.0.0.1:8080

# Required: bearer token for the API. Generate with e.g. `openssl rand -hex 32`.
# The app refuses to start without this set, unless GATEWAY_ALLOW_INSECURE=1.
GATEWAY_API_TOKEN=

# Set GATEWAY_ALLOW_INSECURE=1 to bypass bearer auth entirely.
# ONLY for local LAN testing. A loud warning is printed at boot.
# GATEWAY_ALLOW_INSECURE=0

# Comma-separated list of allowed CORS origins. Empty = no CORS layer
# (same-origin only). Required only if a browser app calls the API directly.
# GATEWAY_CORS_ORIGINS=

# Logging
RUST_LOG=info,inverter_gateway=debug