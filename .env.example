# Copy to .env and fill in real values. NEVER commit .env.
#   cp .env.example .env

# Victron MQTT broker (Cerbo GX) — LAN hostname or IP
MQTT_HOST=cerbo.lan
MQTT_PORT=1883
MQTT_USERNAME=your_mqtt_user
MQTT_PASSWORD=your_mqtt_password
MQTT_CLIENT_ID=inverter-gateway

# Prefer portal id (builds N/<id>/ and W/<id>/ prefixes).
# Fake placeholder for the example file — replace in .env.
VICTRON_PORTAL_ID=your_portal_id_here
# Or set an explicit prefix instead:
# VICTRON_TOPIC_PREFIX=N/your_portal_id_here/

# Bare-metal / SSH tunnel on the host: keep loopback.
# Docker overrides this to 0.0.0.0:8080 via docker-compose.
HTTP_BIND=127.0.0.1:8080

# Required API bearer (openssl rand -hex 32). App refuses to start without it
# unless GATEWAY_ALLOW_INSECURE=1 (local LAN escape hatch only).
GATEWAY_API_TOKEN=replace_with_openssl_rand_hex_32

# Optional bearer for voice adapters and telemetry clients (openssl rand -hex 32).
# Must differ from GATEWAY_API_TOKEN; never authorizes command routes.
# GATEWAY_READ_TOKEN=

# Shared read-only energy contract: GET /v1/energy. See docs/energy-api.md.
# The default battery is the system battery selected by Venus OS.
GATEWAY_ENERGY_BATTERY_SOURCE=system/0/Dc/Battery/Soc
# Explicit source lists avoid arbitrary device selection and double counting.
# Empty lists return "unconfigured". Select actual paths from your installation.
GATEWAY_ENERGY_SOLAR_POWER_SOURCES=
GATEWAY_ENERGY_SOLAR_TODAY_SOURCES=
# Explicit vebus/battery alarm leaves; empty means monitoring is unconfigured.
GATEWAY_ENERGY_ALARM_SOURCES=
GATEWAY_ENERGY_MAX_AGE_SECS=120
# Example DC solar power source (do not also include its individual chargers):
# GATEWAY_ENERGY_SOLAR_POWER_SOURCES=system/0/Dc/Pv/Power
# Example daily counter, replace the instance; Yield/User is NOT today's yield:
# GATEWAY_ENERGY_SOLAR_TODAY_SOURCES=solarcharger/290/History/Daily/0/Yield
# Custom dbus-tasmota-pv daily counter can be added: pvinverter/369/Ac/Energy/Daily
# Example alarm sources, replace instances and choose all required published leaves:
# GATEWAY_ENERGY_ALARM_SOURCES=battery/512/Alarms/LowVoltage,vebus/0/Alarms/L1/Overload

# GATEWAY_ALLOW_INSECURE=0
# GATEWAY_CORS_ORIGINS=

RUST_LOG=info,inverter_gateway=info

# Optional override when using ./deploy-from-release (default: latest GitHub release)
# IMAGE_TAG=0.2.1
# GHCR is public — GHCR_TOKEN not required to pull.
